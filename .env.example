# Pooled connection used by the running application.
DATABASE_URL=

# Direct connection used only by the migration tool.
DATABASE_MIGRATION_URL=

# Required for live episode generation. Create this in the OpenAI Platform.
OPENAI_API_KEY=

# Optional cost-conscious default for structured scene generation.
OPENAI_SCENE_MODEL=gpt-5.4-nano
OPENAI_TURN_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Coaching-first practice flow. These do not change the legacy Sofia flow.
OPENAI_PRACTICE_FAST_MODEL=gpt-5.6-luna
OPENAI_PRACTICE_REFLECTION_MODEL=gpt-5.6-terra
OPENAI_PRACTICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_PRACTICE_SPEECH_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_PRACTICE_COACH_VOICE=cedar
OPENAI_PRACTICE_PARTNER_VOICE=marin

# ElevenLabs is used for one-time prompt playback and retained simulation speech.
# Keep the key server-only; never expose it through NEXT_PUBLIC_* variables.
# Coach speech and transcription remain on OpenAI.
ELEVENLABS_API_KEY=
ELEVENLABS_PARTNER_VOICE_ID=DODLEQrClDo8wCz460ld
ELEVENLABS_PARTNER_MASCULINE_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Temporary rollback only. Leave unset or false for the coaching-first home.
OPENLYTALK_LEGACY_HOME=false

# Required before launch: independent random server-only secrets, at least 32 chars.
# Vercel sends CRON_SECRET as the cron request's Bearer authorization header.
CRON_SECRET=
RATE_LIMIT_SECRET=
